---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import { site, faq } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://matchmove.fr');

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  name: site.name,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  url: canonical.href,
  image: new URL('/assets/logo.png', canonical).href,
  areaServed: { '@type': 'Country', name: 'France' },
  priceRange: '€€',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '08:00',
    closes: '20:00',
  },
};

/* ------------------------------------------------------------------ */
/* Tracking                                                             */
/* ------------------------------------------------------------------ */

/* data-site-id du CMP IwlCMP, site « Matchmove demenagement ».
   Domaine autorisé côté portail : lp-matchmove-demenagement.pages.dev.
   ⚠ À la bascule sur un domaine définitif, l'ajouter aux domaines autorisés
   dans le portail IwlCMP, sinon les preuves de consentement seront refusées.
   Vider cette constante suffit à désactiver CMP + Clarity d'un coup. */
const CMP_SITE_ID: string = 'rhj25avk';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <!-- Noindex volontaire sur toutes les pages (site en pré-prod / hors indexation).
         Appliqué inconditionnellement via Base.astro : toute nouvelle page qui
         utilise ce layout en hérite automatiquement, pas besoin de passer la prop. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#57A479" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/assets/hero.jpg', canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href="/assets/hero.jpg" fetchpriority="high" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- IwlCMP : consent defaults (NE PAS déplacer, doit précéder le CMP) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'url_passthrough', true);
      gtag('set', 'ads_data_redaction', true);
    </script>

    <!-- Microsoft Clarity : chargé UNIQUEMENT quand analytics_storage passe à
         "granted" via gtag('consent','update', ...) — même canal que les
         defaults ci-dessus. Sans CMP pour émettre ce signal, Clarity ne se
         déclenche jamais : c'est voulu (enregistrement de session = consentement
         préalable obligatoire). -->
    <script is:inline>
      (function () {
        var clarityLoaded = false;
        function loadClarity() {
          if (clarityLoaded) return;
          clarityLoaded = true;
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', 'y4bv41o568');
        }
        var dl = window.dataLayer;
        var originalPush = dl.push;
        dl.push = function () {
          for (var i = 0; i < arguments.length; i++) {
            var entry = arguments[i];
            if (
              entry &&
              entry[0] === 'consent' &&
              entry[1] === 'update' &&
              entry[2] &&
              entry[2].analytics_storage === 'granted'
            ) {
              loadClarity();
            }
          }
          return originalPush.apply(this, arguments);
        };
      })();
    </script>

    {
      CMP_SITE_ID && (
        <script is:inline async src="https://cmp.iwantlead.fr/cmp/v1/cmp.js" data-site-id={CMP_SITE_ID} />
      )
    }

    <!-- GTM : à installer plus tard. Le conteneur va ici, suivi du <noscript>
         en tout début de <body>. Les événements dataLayer (form_step,
         lead_submitted) sont déjà émis par le formulaire et seront captés
         automatiquement. -->
  </head>
  <body>
    <slot />
  </body>
</html>
