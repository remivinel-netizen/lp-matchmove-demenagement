---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import Process from '../components/Process.astro';
import StatsBand from '../components/StatsBand.astro';
import OnlineSteps from '../components/OnlineSteps.astro';
import Advantages from '../components/Advantages.astro';
import Partners from '../components/Partners.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<Base>
