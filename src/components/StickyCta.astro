---
import Icon from './Icon.astro';
import { site } from '../data/content';
---

<div class="sticky-cta" data-sticky-cta>
  <a class="btn btn--amber" href={site.phoneHref} data-cta="sticky-phone">
    <Icon name="phone" size={18} />
    Appeler
  </a>
  <a class="btn btn--primary" href="#devis" data-cta="sticky-devis">Obtenir mon devis gratuit</a>
</div>

<button class="scroll-top" type="button" aria-label="Retour en haut" data-scroll-top>
  <Icon name="arrowUp" size={20} />
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-scroll-top]');
  const toggle = () => {
    if (btn) btn.dataset.visible = String(window.scrollY > 600);
  };
  toggle();
  window.addEventListener('scroll', toggle, { passive: true });
  btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // La barre sticky s'efface quand le formulaire est déjà à l'écran :
  // inutile de pousser vers une action déjà visible.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const formCard = document.querySelector<HTMLElement>('[data-quote-card]');
  if (bar && formCard && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        bar.dataset.hidden = String(entry.isIntersecting);
      },
      { threshold: 0.2 },
    ).observe(formCard);
  }
</script>
