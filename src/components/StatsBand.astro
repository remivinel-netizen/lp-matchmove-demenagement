---
import Icon from './Icon.astro';
import { stats } from '../data/content';
---

<section class="stats">
  <div class="container">
    <div class="stats__grid">
      {
        stats.map((stat) => (
          <div class="stats__item">
            <span class="stats__icon">
              <Icon name={stat.icon} size={22} />
            </span>
            <h3>{stat.label}</h3>
          </div>
        ))
      }
    </div>
  </div>
</section>
